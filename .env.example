# Backend (copy to .env and adjust; never commit .env)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
SESSION_TTL_SECONDS=1800
MAX_SESSIONS=64
CLEANUP_INTERVAL_SECONDS=60
MAX_SAMPLES=2000
# Experiment database (SQLite). Saved runs show up on the "My runs" page.
# DB_PATH=backend/data/ailab.db   # Docker Compose sets /srv/data/ailab.db on a named volume
# DB_ENABLED=true                 # false switches saving and the /api/runs endpoints off

# Frontend (build-time, optional). Leave empty to use the same-origin /api proxy.
# VITE_API_BASE=https://api.example.com/api
# VITE_API_PROXY=http://localhost:8000   # dev server proxy target
